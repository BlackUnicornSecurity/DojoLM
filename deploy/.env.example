# DojoLM Production Environment Variables
# Copy to .env and fill in values before deployment
# Generate secrets with: openssl rand -hex 32

# ── REQUIRED secrets (the app refuses to start without these) ────────────────
# Cookie signing key for session claims. MUST be at least 64 hex chars
# (32 bytes). Generate with:    openssl rand -hex 32
# The app throws at startup if missing / too short. Rotate by setting
# `…_PREVIOUS` to the current value, then a fresh value on `…_CURRENT` (the app
# accepts cookies signed by either key during the overlap window).
TPI_COOKIE_SIGNING_KEY_CURRENT=
TPI_COOKIE_SIGNING_KEY_PREVIOUS=

# API Authentication — required in production
# (legacy NODA_API_KEY / NODA_API_KEY_ROLE are still accepted as a fallback)
TPI_API_KEY=
# API key role: admin | analyst | viewer (default: analyst if unset)
TPI_API_KEY_ROLE=analyst

# Database encryption key — at least 32 chars
# Generate with: openssl rand -base64 48
TPI_DB_ENCRYPTION_KEY=

# Storage backend: must be exactly `json` or `db` (default: `json`).
# Any other value makes the app refuse to start with a fail-fast error.
TPI_STORAGE_BACKEND=db

# Admin credentials — created on first run via setup wizard
# Password must meet complexity: 12+ chars, uppercase, lowercase, digit, special char
TPI_ADMIN_USERNAME=admin
TPI_ADMIN_PASSWORD=

# Session TTL in hours
TPI_SESSION_TTL_HOURS=24

# CORS policy is driven by TPI_APP_URL (or NEXT_PUBLIC_APP_URL fallback).
# See packages/dojolm-web/src/lib/request-origin.ts:54 (getConfiguredAppOrigin).
# TPI_CORS_ORIGINS was vestigial and removed in L-03 triage (2026-04-16) —
# it was never consumed by the app or by Caddy. Do not re-introduce.

# Extra trusted browser origins (comma-separated). Use for staging hosts
# accessed via raw IP or alternative hostnames in addition to TPI_APP_URL.
# Example: TPI_ALLOWED_ORIGINS_EXTRA=http://192.0.2.10:3001
TPI_ALLOWED_ORIGINS_EXTRA=

# Staging-only kill-switch: when "true", bypasses both the proxy general
# rate limiter and the per-account login failure limiter. Never enable in
# production — both limiters are part of the abuse-resistance layer.
TPI_RATE_LIMIT_DISABLED=

# Reverse-proxy signal — set to `caddy` when running behind a Caddy reverse
# proxy so X-Forwarded-* headers are trusted. See packages/dojolm-web/src/lib/proxy.ts.
TRUSTED_PROXY=caddy

# Trusted internal IPs / CIDRs for LOCAL MODEL DISCOVERY (comma-separated).
# Allowlist for self-hosted Ollama / LMStudio nodes that are NOT on localhost.
# Without it, discovery of off-host model endpoints is rejected by the SSRF guard
# (see packages/bu-tpi/src/llm/security.ts). Single IPs and CIDR ranges both work.
# Double-check the subnet octets when filling this in — a wrong octet silently
# drops the node from the allowlist and discovery fails.
# Example: TPI_TRUSTED_INTERNAL_IPS=192.168.1.10,192.168.1.11  (or 10.0.0.0/24)
TPI_TRUSTED_INTERNAL_IPS=

# Module UI feature flags — admin module pages read these as env vars.
# All default to false in code; uncomment + set to "true" to expose the
# module page without an admin override. Required for staging audits.
SCANNER_UI_ENABLED=
BUKI_UI_ENABLED=
JUTSU_UI_ENABLED=
ARENA_UI_ENABLED=
SENGOKU_UI_ENABLED=
HATTORI_UI_ENABLED=
KOTOBA_UI_ENABLED=
MITSUKE_UI_ENABLED=
AMATERASU_UI_ENABLED=
KAGAMI_UI_ENABLED=
RONIN_UI_ENABLED=
SHINGAN_UI_ENABLED=
MEMBERS_UI_ENABLED=

# Edition gate (client-side, build-baked NEXT_PUBLIC_*). Leave UNSET on
# community / self-host installs: the admin shell then skips polling the
# governance-only kill-switch status endpoint (`/api/admin/kill-switch/status`),
# which would otherwise just 401 and spam the browser console (F-QA-020).
# Enterprise / governance builds set this to "true" to enable the kill-switch
# status badge + banner. See packages/dojolm-web/src/lib/edition.ts.
NEXT_PUBLIC_ENTERPRISE_EDITION=

# Ollama base URL for LLM operations
OLLAMA_BASE_URL=http://localhost:11434

# LLM Guard HMAC signing key
GUARD_CONFIG_SECRET=

# ── Deployment (docker-compose) ───────────────────────────────────────────────
# Browser-facing origin of the app. OPTIONAL — when unset, the app derives
# its trusted origin from the incoming request's Host header, so a single-host
# deploy behind any hostname (LAN IP, LAN DNS, ngrok, …) works without rebuilds.
# Set this only for multi-domain deploys where you want to PIN the trusted
# origin to one canonical URL (e.g. https://dojo.example.com).
TPI_APP_URL=

# Postgres service in deploy/docker-compose.yml. DOJOLM_DB_PASSWORD is required.
DOJOLM_DB_NAME=dojolm
DOJOLM_DB_USER=dojolm
DOJOLM_DB_PASSWORD=

# Names of the EXTERNAL Docker volume + edge network referenced by
# deploy/docker-compose.yml (production). Create them before the first
# `compose up`, or override these names to match your existing resources.
DOJOLM_DATA_VOLUME=dojolm_data
DOJOLM_EDGE_NETWORK=edge-net

# ── Standalone public edge (dojolm-edge) — OPT-IN ────────────────────────────
# dojolm-edge (Caddy) is gated behind the compose `edge` profile, default OFF.
# Leave it OFF when an upstream terminator already serves :443 for your hostname
# (e.g. a platform Caddy that reverse-proxies straight to dojolm-web:42001) — a
# standalone edge would only collide on host :443. Enable it ONLY on a host with
# no upstream terminator. Enable via ONE of:
#   - docker compose --profile edge up -d
#   - the COMPOSE_PROFILES line below (affects a MANUAL `docker compose up`).
# COMPOSE_PROFILES=edge
#
# External Caddy-storage volume the edge mounts for its internal-CA PKI. Only
# referenced when the `edge` profile is active. Create + seed it with your
# internal CA BEFORE the first `compose up --profile edge`.
DOJOLM_EDGE_DATA_VOLUME=dojolm_edge_data
