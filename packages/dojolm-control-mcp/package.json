{
  "name": "@dojolm/mcp-control",
  "version": "0.1.0",
  "description": "DojoLM control-plane MCP server — exposes the platform's OSS-safe tool catalog + red-team skill prompts over stdio and HTTP, for Sensei and external agents (Claude Desktop / Cursor / opencode).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "dojolm-control-mcp": "./dist/transports/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/transports/http.js",
    "start:stdio": "node dist/transports/stdio.js",
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  },
  "private": true
}
